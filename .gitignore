# --- dependencies & caches (rebuilt per machine) ---
node_modules/
local_cache/
.claude/logs/
.claude/ambient.lock
.claude/watcher.lock
.claude/tmp_*

# --- vector store (rebuilt locally) ---
.claude/memory/vector_store.json
.claude/memory/vector_store.json.*
.claude/memory/vector_store.db
.claude/memory/vector_store.db-*

# --- runtime-generated memory (stays on the machine) ---
journal/
library/
cards/
themes/
graph/
HOME.md

# --- personal identity / config: NEVER tracked ---
.claude/memory/core_profile.json
.claude/memory/backups/
# The build ledger is the DEVELOPMENT vault decision log. It is not part of the
# product and it names real projects and people; a stray copy would ship them.
.claude/memory/build-decisions.jsonl
.claude/memory/.install-version.json
.claude/memory/.migration-progress.json
.claude/lkhs.config.json
~/.claude/lkhs-capture-config.json
answers.json

# --- persona layer: deep user model + raw chat dump + clinical tier: never leave the machine ---
.claude/memory/persona_raw/
.claude/persona_raw/
persona/
persona_clinical/
.claude/memory/persona_facts.jsonl
.claude/memory/persona_clinical.jsonl

# --- domain tiles generated at runtime (keep the dir, ignore contents except schema) ---
.claude/memory/domains/*.json

# --- misc ---
.env
.env.local
*.log
.DS_Store
Thumbs.db

# runtime state (per-install, never shipped)
.claude/memory/store_hygiene.json
.claude/memory/preference_mined.json
.claude/memory/voice_recal_state.json
.claude/memory/voice-rule-proposals.jsonl
.claude/memory/reports/
.claude/memory/eval/runs/


# Learning system: MACHINERY ships, OBSERVATIONS do not. These are facts about one
# person's machine and working style; a fresh install must mine its own.
.claude/memory/lessons.jsonl
.claude/memory/episodes.jsonl
.claude/memory/PLAYBOOK.md
.claude/memory/lesson-proposals.jsonl
.claude/memory/episode_mined.json
.claude/memory/preference_mined.json
.claude/memory/cache/llm/
graph/ppr-index.json
